{
  "discovery_roots": ["~/Projects"],
  "repositories": ["~/dotfiles"],
  "exclude_repositories": ["~/Projects/archive/**"],
  "ignore_directories": [
    ".git",
    ".hg",
    ".svn",
    "node_modules",
    ".direnv",
    ".cache",
    "dist",
    "build",
    "target",
    "coverage",
    ".next",
    ".turbo",
    ".gradle",
    "__pycache__"
  ],
  "store_dir": null,
  "max_file_size_mb": 10,
  "discovery_max_depth": 4,
  "discovery_interval_seconds": 60
}

