[Unit]
Description=Event-driven Git-backed local file history
Documentation=https://github.com/AkisArou/local-history
After=graphical-session.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/local-history daemon
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
